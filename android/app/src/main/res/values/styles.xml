<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/pg_background</item>
        <item name="android:statusBarColor">@color/pg_background</item>
        <item name="android:navigationBarColor">@color/pg_background</item>
        <item name="android:windowLightStatusBar">@bool/pg_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/pg_light_bars</item>
        <item name="android:colorAccent">@color/pg_accent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
    </style>

</resources>
